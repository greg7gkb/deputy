<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Debug-only driver for emulator testing. Guarded by DUMP, which only the adb shell holds,
          so no app on the device can send it. It can run the planner and simulated askers,
          never the user's approvals: those stay behind a real tap.
        -->
        <receiver
            android:name=".DebugDriver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.greg7gkb.deputy.DRIVE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
