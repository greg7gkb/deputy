<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The cloud planner (Phase 1) is the only thing that uses the network: it sends your
         request and typed results to the Claude API. A "normal" permission: granted at install. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The calendar adapter (tier 1). Read for busy times only; write for holds and invites. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name=".DeputyApp"
        android:allowBackup="false"
        android:label="Deputy"
        android:supportsRtl="true"
        android:theme="@style/Theme.Deputy">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- deputy://activity/<artifact id>: links Deputy writes into what it creates (D19).
                 Opening one only shows an Activity entry; it can never act. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="deputy" android:host="activity" />
            </intent-filter>
            <!-- The same links as https App Links, verified against the host's assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${linkHost}" android:pathPrefix="${linkPath}" />
            </intent-filter>
        </activity>
        <!-- Tier 1: notification triage. Granted by the user in Settings (Notification access). -->
        <service
            android:name=".notifications.DeputyNotificationListener"
            android:exported="true"
            android:label="Deputy"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
